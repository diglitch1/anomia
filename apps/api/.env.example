# Server
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 on DigitalOcean App Platform, 0 locally)
TRUST_PROXY_HOPS=0

# Gemma provider: "gemini" (hosted) or "ollama" (local)
GEMMA_PROVIDER=gemini
GEMINI_API_KEY=
# Optional. Must exist in the Gemini models list; otherwise E4B is auto-selected.
GEMMA_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ElevenLabs (speech, cloning, speech-to-text fallback)
ELEVENLABS_API_KEY=
DEFAULT_VOICE_ID=
