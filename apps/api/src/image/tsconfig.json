{
  "//": "TEMPORARY standalone harness, see package.json description.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "sharp": ["./node_modules/sharp"],
      "vitest": ["./node_modules/vitest"],
      "exif-reader": ["./node_modules/exif-reader"],
      "@google/genai": ["./node_modules/@google/genai"]
    }
  },
  "include": ["*.ts", "../../test/image*.test.ts", "../../../../scripts/*-image*.ts"]
}
